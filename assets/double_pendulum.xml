<mujoco>
  <worldbody>
    <!-- Hovering Torso -->
    <body name="torso" pos="0 0 1.5">
      <geom type="cylinder" size="0.1 0.3" rgba="0.8 0.2 0.2 1" mass="10"/>

      <!-- Pendulum Link 1: The Arm -->
      <body name="arm" pos="0 -0.15 0.2">
        <!-- Joint 1: The Shoulder -->
        <joint name="shoulder" type="hinge" axis="0 0.866 0.5"/>
        <geom type="capsule" size="0.03" fromto="0 0 0 0 0 -0.7" rgba="0.8 0.8 0.2 1" mass="2"/>
        
        <!-- The Wrist (Anchor for Pendulum Link 2) -->
        <body name="wrist_mount" pos="0 0 -0.7">
          <!-- Joint 2: The Wrist (Parallel to the shoulder) -->
          <joint name="wrist" type="hinge" axis="0 0.866 0.5"/>
          <!-- Visual marker for the wrist joint -->
          <geom type="sphere" size="0.035" rgba="0.2 0.2 0.8 1" mass="0.1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position joint="shoulder" name="ctrl_shoulder" kp="800"/>
    <position joint="wrist" name="ctrl_wrist" kp="300"/>
  </actuator>
</mujoco>