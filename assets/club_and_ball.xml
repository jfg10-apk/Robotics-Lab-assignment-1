<mujoco>
  <worldbody>
    <!-- The Golf Ball -->
    <body name="ball" pos="0.1 -0.15 0.0216">
      <freejoint/>
      <geom type="sphere" size="0.0216" rgba="1 1 1 1" mass="0.045"/>
    </body>

    <!-- The Golf Club -->
    <!-- Spawned roughly near the hand so the weld constraint doesn't snap violently on frame 1 -->
    <body name="club" pos="0 -0.15 0.8">
      <freejoint/>
      
      <!-- The Shaft -->
      <geom type="cylinder" fromto="0 0 0 0 0 -0.76" size="0.01" rgba="0.8 0.8 0.8 1" mass="0.3"/>
      <!-- The Head -->
      <geom type="box" pos="0.02 -0.02 -0.76" size="0.01 0.04 0.02" rgba="0.3 0.3 0.3 1" mass="0.2"/>
      
      <!-- The site that gets welded to the robot's hand -->
      <site name="club_handle_site" pos="0 0 0" size="0.01" rgba="0 0 1 1"/>
      <!-- The site used to calculate Inverse Kinematics -->
      <site name="club_head_site" pos="0.02 0 -0.76" size="0.01" rgba="1 0 0 1"/>
    </body>
  </worldbody>
</mujoco>